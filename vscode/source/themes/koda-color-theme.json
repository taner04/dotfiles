    "scrollbarSlider.background": "#2a2a2a80",
    "scrollbarSlider.hoverBackground": "#3d3d3d",
    "scrollbarSlider.activeBackground": "#4a4a4a",
    "progressBar.background": "#d0d0d0",
    "textLink.foreground": "#b8b8b8",
    "textLink.activeForeground": "#ffffff",
    "gitDecoration.modifiedResourceForeground": "#bfb38a",
    "gitDecoration.untrackedResourceForeground": "#8fa58f",
    "gitDecoration.deletedResourceForeground": "#b07a7a",
    "gitDecoration.ignoredResourceForeground": "#3d3d3d",
    "breadcrumb.foreground": "#5c5c5c",
    "breadcrumb.focusForeground": "#d0d0d0",
    "minimap.background": "#0e0e0e",
    "peekView.border": "#3d3d3d",
    "peekViewEditor.background": "#101010",
    "peekViewResult.background": "#0a0a0a",
    "notifications.background": "#101010",
    "notifications.border": "#2a2a2a"
