    "activityBar.activeBorder": "#d0d0d0",
    "activityBarBadge.background": "#d0d0d0",
    "activityBarBadge.foreground": "#0e0e0e",
    "titleBar.activeBackground": "#0a0a0a",
    "titleBar.activeForeground": "#a6a6a6",
    "titleBar.inactiveBackground": "#0a0a0a",
    "titleBar.border": "#1e1e1e",
    "statusBar.background": "#0a0a0a",
    "statusBar.foreground": "#707070",
    "statusBar.border": "#1e1e1e",
    "statusBar.debuggingBackground": "#262626",
    "statusBar.noFolderBackground": "#0a0a0a",
    "statusBarItem.remoteBackground": "#1a1a1a",
    "statusBarItem.remoteForeground": "#d0d0d0",
    "panel.background": "#0a0a0a",
    "panel.border": "#1e1e1e",
    "panelTitle.activeForeground": "#e0e0e0",
    "panelTitle.activeBorder": "#d0d0d0",
    "panelTitle.inactiveForeground": "#5c5c5c",
    "terminal.background": "#0e0e0e",
    "terminal.foreground": "#d6d6d6",
    "terminalCursor.foreground": "#e0e0e0",
    "terminal.ansiBlack": "#1e1e1e",
    "terminal.ansiRed": "#b07a7a",
    "terminal.ansiGreen": "#8fa58f",
    "terminal.ansiYellow": "#bfb38a",
    "terminal.ansiBlue": "#8496a9",
    "terminal.ansiMagenta": "#a08fa8",
    "terminal.ansiCyan": "#8aa8a8",
    "terminal.ansiWhite": "#bdbdbd",
    "terminal.ansiBrightBlack": "#4a4a4a",
    "terminal.ansiBrightRed": "#c99595",
    "terminal.ansiBrightGreen": "#a8bea8",
    "terminal.ansiBrightYellow": "#d6cba3",
    "terminal.ansiBrightBlue": "#a0b2c4",
    "terminal.ansiBrightMagenta": "#bbabc3",
    "terminal.ansiBrightCyan": "#a6c3c3",
    "terminal.ansiBrightWhite": "#ededed",
    "focusBorder": "#2a2a2a",
    "foreground": "#a6a6a6",
    "descriptionForeground": "#707070",
    "widget.shadow": "#00000080",
    "selection.background": "#3a3a3a",
    "button.background": "#d0d0d0",
    "button.foreground": "#0e0e0e",
    "button.hoverBackground": "#ffffff",
    "button.secondaryBackground": "#262626",
    "button.secondaryForeground": "#d0d0d0",
    "input.background": "#141414",
    "input.border": "#2a2a2a",
    "input.foreground": "#d0d0d0",
    "input.placeholderForeground": "#4a4a4a",
    "inputOption.activeBorder": "#848484",
    "dropdown.background": "#141414",
    "dropdown.border": "#2a2a2a",
    "list.activeSelectionBackground": "#262626",
    "list.activeSelectionForeground": "#ffffff",
    "list.inactiveSelectionBackground": "#1a1a1a",
    "list.hoverBackground": "#161616",
    "list.highlightForeground": "#ffffff",
    "list.focusOutline": "#3d3d3d",
    "quickInput.background": "#101010",
    "quickInputList.focusBackground": "#262626",
    "badge.background": "#262626",
