    "editorSuggestWidget.background": "#101010",
    "editorSuggestWidget.selectedBackground": "#262626",
    "editorSuggestWidget.highlightForeground": "#ffffff",
    "editorHoverWidget.background": "#101010",
    "editorGroup.border": "#1e1e1e",
    "editorGroupHeader.tabsBackground": "#0a0a0a",
    "tab.activeBackground": "#0e0e0e",
    "tab.activeForeground": "#e0e0e0",
    "tab.activeBorderTop": "#d0d0d0",
    "tab.inactiveBackground": "#0a0a0a",
    "tab.inactiveForeground": "#5c5c5c",
    "tab.border": "#0a0a0a",
    "sideBar.background": "#0a0a0a",
    "sideBar.foreground": "#8a8a8a",
    "sideBar.border": "#1e1e1e",
    "sideBarTitle.foreground": "#d0d0d0",
    "sideBarSectionHeader.background": "#0a0a0a",
    "activityBar.background": "#0a0a0a",
    "activityBar.foreground": "#d0d0d0",
