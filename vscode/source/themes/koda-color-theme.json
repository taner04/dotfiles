{
  "name": "Koda",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#e0e0e0",
    "method": "#e0e0e0",
    "function.defaultLibrary": "#e0e0e0",
    "class": "#8496a9",
    "struct": "#8496a9",
    "enum": "#8496a9",
    "type": "#8496a9",
    "typeParameter": {
      "foreground": "#8496a9",
      "italic": true
    },
    "interface": {
      "foreground": "#8aa8a8",
      "italic": true
    },
    "trait": {
      "foreground": "#8aa8a8",
      "italic": true
    },
    "enumMember": "#bfb38a",
    "namespace": "#b8b8b8",
    "parameter": {
      "foreground": "#b8b8b8",
      "italic": true
    },
    "property": "#a6a6a6",
    "variable": "#a6a6a6",
    "variable.readonly": "#bfb38a",
    "variable.constant": "#bfb38a",
    "keyword": {
      "foreground": "#d0d0d0",
      "bold": true
    },
    "string": "#8fa58f",
    "number": "#bfb38a",
    "comment": {
      "foreground": "#5c5c5c",
      "italic": true
    },
    "macro": "#8aa8a8",
    "lifetime": {
      "foreground": "#bfb38a",
      "italic": true
    },
    "decorator": "#a08fa8",
    "attribute": "#a08fa8",
    "selfKeyword": {
      "foreground": "#d0d0d0",
      "italic": true
    },
    "*.mutable": {
      "underline": true
    }
  },
  "colors": {
    "editor.background": "#0e0e0e",
    "editor.foreground": "#a6a6a6",
    "editor.lineHighlightBackground": "#1a1a1a",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#2a2a2a",
    "editor.inactiveSelectionBackground": "#1e1e1e",
    "editor.wordHighlightBackground": "#262626",
    "editor.findMatchBackground": "#5c5c5c80",
    "editor.findMatchHighlightBackground": "#3d3d3d80",
    "editorLineNumber.foreground": "#3d3d3d",
    "editorLineNumber.activeForeground": "#d0d0d0",
    "editorCursor.foreground": "#e0e0e0",
    "editorWhitespace.foreground": "#262626",
    "editorIndentGuide.background1": "#1c1c1c",
    "editorIndentGuide.activeBackground1": "#3d3d3d",
    "editorBracketMatch.background": "#262626",
    "editorBracketMatch.border": "#5c5c5c",
    "editorGutter.addedBackground": "#848484",
    "editorGutter.modifiedBackground": "#5c5c5c",
    "editorGutter.deletedBackground": "#b07a7a",
    "editorError.foreground": "#b07a7a",
    "editorWarning.foreground": "#bfb38a",
    "editorInfo.foreground": "#8496a9",
    "editorWidget.background": "#101010",
