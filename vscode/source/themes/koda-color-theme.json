  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5c5c5c",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "source",
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#a6a6a6"
      }
    },
    {
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#707070"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "keyword.declaration"
      ],
      "settings": {
        "foreground": "#d0d0d0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#d0d0d0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "#e0e0e0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.cs",
        "keyword.type.cs",
        "storage.type.primitive",
        "entity.name.type.primitive.rust"
      ],
      "settings": {
        "foreground": "#8496a9"
      }
    },
    {
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.trait",
        "entity.name.type.interface.cs",
        "entity.name.type.trait.rust"
      ],
      "settings": {
        "foreground": "#8aa8a8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type.enum",
        "entity.name.type.struct"
      ],
      "settings": {
        "foreground": "#8496a9"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#8fa58f"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "punctuation.definition.template-expression",
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#a8bea8"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.other.caps",
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other.enum"
      ],
      "settings": {
        "foreground": "#bfb38a"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b07a7a"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#b8b8b8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self.rust",
        "keyword.other.this.cs"
      ],
      "settings": {
        "foreground": "#d0d0d0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "entity.name.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#a6a6a6"
      }
    },
    {
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.type.namespace",
        "meta.use.rust entity.name.namespace"
      ],
      "settings": {
        "foreground": "#b8b8b8"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.decorator variable.other.readwrite",
        "meta.attribute",
        "meta.attribute.rust",
        "entity.name.type.attribute.cs",
        "punctuation.definition.attribute"
      ],
      "settings": {
        "foreground": "#a08fa8"
      }
    },
    {
      "scope": [
        "entity.name.function.macro",
        "entity.name.function.macro.rust",
        "support.macro.rust",
        "meta.macro.rust"
      ],
      "settings": {
        "foreground": "#8aa8a8"
      }
    },
    {
      "scope": [
        "entity.name.type.lifetime",
        "entity.name.type.lifetime.rust",
        "punctuation.definition.lifetime.rust",
        "storage.modifier.lifetime.rust"
      ],
      "settings": {
        "foreground": "#bfb38a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator.borrow.rust",
        "keyword.operator.dereference.rust",
        "storage.modifier.mut.rust"
      ],
      "settings": {
        "foreground": "#d0d0d0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml.doctype"
      ],
      "settings": {
        "foreground": "#8496a9"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#a08fa8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.other.ng-binding-name",
        "entity.other.attribute-name.ng",
        "punctuation.definition.ng-binding-name",
        "support.function.pipe.ng",
        "entity.name.function.pipe.ng"
      ],
      "settings": {
        "foreground": "#a08fa8"
      }
    },
    {
      "scope": [
        "meta.ng-binding",
        "expression.ng"
      ],
      "settings": {
        "foreground": "#a6a6a6"
      }
    },
    {
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#707070"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#8496a9"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#a6a6a6"
      }
    },
    {
      "scope": [
        "support.constant.property-value",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#bfb38a"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#d0d0d0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#d0d0d0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#8fa58f"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#8496a9"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b07a7a"
      }
    }
  ]
}