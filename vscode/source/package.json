{
  "name": "koda-theme",
  "displayName": "Koda",
  "description": "Dark monochrome theme matching the Koda terminal, Neovim and Spotify setup",
  "version": "1.2.0",
  "publisher": "taner04",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/taner04/koda-theme"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Koda",
        "uiTheme": "vs-dark",
        "path": "./themes/koda-color-theme.json"
      },
      {
        "label": "Koda Light",
        "uiTheme": "vs",
        "path": "./themes/koda-light-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', Menlo, monospace",
      "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
      "editor.fontLigatures": true,
      "window.autoDetectColorScheme": true,
      "workbench.preferredDarkColorTheme": "Koda",
      "workbench.preferredLightColorTheme": "Koda Light"
    }
  }
}